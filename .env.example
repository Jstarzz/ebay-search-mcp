# eBay official Browse API
EBAY_CLIENT_ID=your-client-id
EBAY_CLIENT_SECRET=your-client-secret
EBAY_MARKETPLACE_ID=EBAY_US

# Existing Best Buy Products API support
BESTBUY_API_KEY=your-api-key

# Self-hosted scraper endpoints (optional fallbacks).
# Contract: POST JSON search options and return an array, {results:[...]}, {products:[...]}, or {items:[...]}.
EBAY_SELFHOSTED_URL=
AMAZON_SELFHOSTED_URL=
ALIEXPRESS_SELFHOSTED_URL=

# Amazon recurring-free/shared providers
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_AMAZON_DATASET_ID=gd_l7q7dkf244hwjntr0
SCRAPINGDOG_API_KEY=
HASDATA_API_KEY=
SERPAPI_API_KEY=
AMAZON_DOMAIN=www.amazon.com
AMAZON_TLD=com
SERPAPI_AMAZON_DOMAIN=amazon.com

# Apify shared monthly-credit path.
# Actor IDs may be username/actor-name or username~actor-name.
APIFY_TOKEN=
APIFY_AMAZON_ACTOR_ID=
APIFY_ALIEXPRESS_ACTOR_ID=

# AliExpress official Affiliate API (optional; requires approved access)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/sync
# md5 is the default; set hmac only if your AliExpress app requires that signing mode.
ALIEXPRESS_SIGN_METHOD=md5

# Trial/reserve pool. Never treat these as guaranteed recurring capacity.
# These are registered in routing policy now; native structured adapters can be added/rotated independently.
OXYLABS_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPERAPI_API_KEY=
CRAWLBASE_API_KEY=
ZYTE_API_KEY=
DECODO_API_KEY=

# Optional defaults. The MCP should ask before assuming a destination.
DEFAULT_SHIP_TO_COUNTRY=US
DEFAULT_SHIP_TO_POSTAL_CODE=
