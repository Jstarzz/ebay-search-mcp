# eBay Browse API (required for eBay tools)
EBAY_CLIENT_ID=your-client-id
EBAY_CLIENT_SECRET=your-client-secret
EBAY_MARKETPLACE_ID=EBAY_US

# Best Buy Products API (optional)
BESTBUY_API_KEY=your-api-key

# Optional defaults. Claude should ask before assuming a destination.
DEFAULT_SHIP_TO_COUNTRY=US
DEFAULT_SHIP_TO_POSTAL_CODE=
