# eBay official Browse API
EBAY_CLIENT_ID=your-client-id
EBAY_CLIENT_SECRET=your-client-secret
EBAY_MARKETPLACE_ID=EBAY_US

# Existing Best Buy Products API support
BESTBUY_API_KEY=your-api-key

# Self-hosted scraper endpoints (optional fallbacks)
EBAY_SELFHOSTED_URL=
AMAZON_SELFHOSTED_URL=
ALIEXPRESS_SELFHOSTED_URL=

# Recurring-free/shared providers
BRIGHT_DATA_API_KEY=
SCRAPINGDOG_API_KEY=
HASDATA_API_KEY=
APIFY_TOKEN=
SERPAPI_API_KEY=

# AliExpress official affiliate API (optional, requires approved access)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Trial/reserve pool. Never treat these as guaranteed recurring capacity.
OXYLABS_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPERAPI_API_KEY=
CRAWLBASE_API_KEY=
ZYTE_API_KEY=
DECODO_API_KEY=

# Optional defaults. The MCP should ask before assuming a destination.
DEFAULT_SHIP_TO_COUNTRY=US
DEFAULT_SHIP_TO_POSTAL_CODE=
